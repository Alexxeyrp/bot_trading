# Node.js 22. Los defaults iniciales se guardan en Redis en la primera petición.
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Scanner desactivado inicialmente. /run lo activa de forma persistente.
SCANNER_ACTIVE=false
SYMBOL=BTCUSDT
TIMEFRAME=5m
MIN_CONFIDENCE=75
MIN_CANDLES=50
CANDLE_LIMIT=200
ENABLED_PATTERNS=doublebottom,doubletop,ascendingtriangle
ALERT_COOLDOWN_SECONDS=3600
DEBUG_PATTERNS=false
DOUBLE_BOTTOM_TOLERANCE=0.02
DOUBLE_TOP_TOLERANCE=0.02
TRIANGLE_TOLERANCE=0.02
BREAKOUT_CONFIRMATION_PERCENT=0.001
MIN_PATTERN_SEPARATION=5
PIVOT_WINDOW=2

# Solo datos de mercado. Binance no requiere clave.
DATA_PROVIDER=binance
MARKET_DATA_API_URL=https://api.binance.com
MARKET_DATA_API_KEY=
# Alternativa existente: DATA_PROVIDER=twelvedata
# MARKET_DATA_API_URL=https://api.twelvedata.com
# MARKET_DATA_API_KEY=<tu clave>
# SYMBOL=EURUSD (Twelve Data admite aquí únicamente Forex)

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Solo para grupos: ID del usuario administrador individual autorizado.
TELEGRAM_ADMIN_USER_ID=
# Secreto aleatorio: 16-256 caracteres A-Z, a-z, 0-9, _ o -
TELEGRAM_WEBHOOK_SECRET=
# Secreto aleatorio de al menos 16 caracteres.
CRON_SECRET=

# URL HTTPS y token de escritura de Upstash Redis (REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Usa otro prefijo o base independiente para pruebas/Preview.
STORAGE_PREFIX=trading-bot-production

# Solo para registrar el webhook desde tu ordenador, tras desplegar.
DEPLOYMENT_URL=
