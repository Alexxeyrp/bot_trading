{
  "name": "trading-pattern-alert-bot",
  "version": "0.1.0",
  "description": "Bot modular para detectar patrones de trading y enviar alertas a Telegram.",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "scan": "node scripts/scan.js",
    "test": "node scripts/test.js",
    "check": "node scripts/check.js",
    "telegram:webhook": "node scripts/telegram-webhook.js",
    "telegram:info": "node scripts/telegram-info.js",
    "telegram:chat-id": "node scripts/telegram-chat-id.js",
    "config:check": "node scripts/validate-env.js"
  },
  "keywords": [
    "trading",
    "patterns",
    "alerts",
    "telegram"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "winston": "^3.17.0"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "wasmoon": "^1.16.0"
  }
}
