{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "installCommand": "npm ci",
  "fluid": true,
  "outputDirectory": "public",
  "regions": ["cdg1"],
  "functions": {
    "api/scan.js": {
      "maxDuration": 120
    },
    "api/telegram.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/scan",
      "schedule": "0 8 * * *"
    }
  ]
}
